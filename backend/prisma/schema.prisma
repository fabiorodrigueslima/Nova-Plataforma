generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  Int                @id @default(autoincrement())
  nome                String             @db.VarChar(150)
  email               String             @unique @db.VarChar(150)
  senha               String?
  googleId            String?            @unique @map("google_id")
  provider            String             @default("local") @db.VarChar(30)
  foto                String?
  bio                 String?
  essenciaRepresenta  String?            @map("essencia_representa")
  essenciaTema        String?            @map("essencia_tema")
  essenciaFrase       String?            @map("essencia_frase")
  abertoPara          String?            @map("aberto_para")
  ultimoAcesso        DateTime?          @map("ultimo_acesso") @db.Timestamp(6)
  papel               String             @default("usuario") @db.VarChar(20)
  suspensoAte         DateTime?          @map("suspenso_ate") @db.Timestamp(6)
  suspensoMotivo      String?            @map("suspenso_motivo") @db.VarChar(300)
  tokenRecuperacao    String?            @map("token_recuperacao")
  tokenExpira         DateTime?          @map("token_expira") @db.Timestamp(6)
  criadoEm            DateTime           @default(now()) @map("criado_em") @db.Timestamp(6)
  posts               Post[]
  comentarios         Comentario[]
  curtidas            Curtida[]
  compartilhamentos   Compartilhamento[]
  seguindo            Seguidor[]         @relation("UsuarioSeguidor")
  seguidores          Seguidor[]         @relation("UsuarioSeguindo")
  mensagensEnviadas   MensagemPrivada[]  @relation("MensagemRemetente")
  mensagensRecebidas  MensagemPrivada[]  @relation("MensagemDestinatario")
  gruposCriados       Grupo[]
  gruposComoMembro    GrupoMembro[]
  mensagensEmGrupos   GrupoMensagem[]
  solicitacoesGrupo   GrupoSolicitacao[]
  denunciasFeitas     Denuncia[]         @relation("Denunciante")
  denunciasRecebidas  Denuncia[]         @relation("UsuarioDenunciado")
  sessoes             Session[]
  notificacoes        Notificacao[]      @relation("NotificacaoDestinatario")
  notificacoesCriadas Notificacao[]      @relation("NotificacaoAtor")
  denunciasResolvidas Denuncia[]         @relation("DenunciaModerador")
  bloqueiosFeitos     Bloqueio[]         @relation("Bloqueador")
  bloqueiosRecebidos  Bloqueio[]         @relation("Bloqueado")
  posicoesDebate      DebatePosicao[]
  argumentos          DebateArgumento[]
  votosArgumento      ArgumentoVoto[]
  mudancasOpiniao     MudancaOpiniao[]

  @@map("usuarios")
}

model Session {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)
  ultimoUsoEm DateTime? @map("ultimo_uso_em") @db.Timestamp(6)
  expiraEm    DateTime  @map("expira_em") @db.Timestamp(6)
  revogadoEm  DateTime? @map("revogado_em") @db.Timestamp(6)
  userAgent   String?   @map("user_agent") @db.VarChar(300)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_sessoes_usuario_id")
  @@index([expiraEm], map: "idx_sessoes_expira_em")
  @@index([revogadoEm], map: "idx_sessoes_revogado_em")
  @@map("sessoes")
}

model ExclusaoConta {
  id           Int       @id @default(autoincrement())
  usuarioId    Int?      @map("usuario_id")
  nome         String?   @db.VarChar(150)
  email        String?   @db.VarChar(150)
  motivo       String?
  status       String    @default("concluida") @db.VarChar(50)
  solicitadoEm DateTime  @default(now()) @map("solicitado_em") @db.Timestamp(6)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamp(6)

  @@index([solicitadoEm], map: "idx_exclusoes_conta_solicitado_em")
  @@map("exclusoes_conta")
}

model Post {
  id                Int                @id @default(autoincrement())
  usuarioId         Int                @map("usuario_id")
  conteudo          String?
  tema              String?            @db.VarChar(100)
  sentimento        String?            @db.VarChar(100)
  imagem            String?
  tipoArquivo       String?            @map("tipo_arquivo") @db.VarChar(50)
  nomeArquivo       String?            @map("nome_arquivo")
  // "post" comum ou "debate" (pergunta com dois lados nomeados)
  tipo              String             @default("post") @db.VarChar(20)
  ladoA             String?            @map("lado_a") @db.VarChar(60)
  ladoB             String?            @map("lado_b") @db.VarChar(60)
  criadoEm          DateTime           @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm      DateTime           @default(now()) @map("atualizado_em") @db.Timestamp(6)
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  comentarios       Comentario[]
  curtidas          Curtida[]
  compartilhamentos Compartilhamento[]
  denuncias         Denuncia[]
  notificacoes      Notificacao[]
  posicoes          DebatePosicao[]
  argumentos        DebateArgumento[]
  mudancasOpiniao   MudancaOpiniao[]

  @@index([usuarioId], map: "idx_posts_usuario_id")
  @@index([criadoEm(sort: Desc)], map: "idx_posts_criado_em")
  @@map("posts")
}

model Curtida {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, postId])
  @@index([postId], map: "idx_curtidas_post_id")
  @@map("curtidas")
}

model Comentario {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  conteudo  String
  texto     String?
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "idx_comentarios_post_id")
  @@index([usuarioId], map: "idx_comentarios_usuario_id")
  @@map("comentarios")
}

model Seguidor {
  id         Int      @id @default(autoincrement())
  seguidorId Int      @map("seguidor_id")
  seguindoId Int      @map("seguindo_id")
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  seguidor   Usuario  @relation("UsuarioSeguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguindo   Usuario  @relation("UsuarioSeguindo", fields: [seguindoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguindoId])
  @@index([seguidorId], map: "idx_seguidores_seguidor_id")
  @@index([seguindoId], map: "idx_seguidores_seguindo_id")
  @@map("seguidores")
}

model Compartilhamento {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, postId])
  @@index([postId], map: "idx_compartilhamentos_post_id")
  @@index([usuarioId], map: "idx_compartilhamentos_usuario_id")
  @@map("compartilhamentos")
}

model Notificacao {
  id             Int       @id @default(autoincrement())
  destinatarioId Int       @map("destinatario_id")
  atorId         Int?      @map("ator_id")
  tipo           String    @db.VarChar(30)
  mensagem       String    @db.VarChar(240)
  postId         Int?      @map("post_id")
  lidaEm         DateTime? @map("lida_em") @db.Timestamp(6)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)
  destinatario   Usuario   @relation("NotificacaoDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  ator           Usuario?  @relation("NotificacaoAtor", fields: [atorId], references: [id], onDelete: SetNull)
  post           Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([destinatarioId, lidaEm, criadoEm(sort: Desc)], map: "idx_notificacoes_caixa_entrada")
  @@index([postId], map: "idx_notificacoes_post_id")
  @@map("notificacoes")
}

model Denuncia {
  id                 Int       @id @default(autoincrement())
  denuncianteId      Int?      @map("denunciante_id")
  usuarioId          Int?      @map("usuario_id")
  postId             Int?      @map("post_id")
  motivo             String
  status             String    @default("pendente") @db.VarChar(50)
  // Cópia do conteúdo denunciado: o histórico de moderação sobrevive à remoção do post.
  conteudoDenunciado String?   @map("conteudo_denunciado")
  acao               String?   @db.VarChar(30)
  resolvidoPorId     Int?      @map("resolvido_por_id")
  resolvidoEm        DateTime? @map("resolvido_em") @db.Timestamp(6)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)
  denunciante        Usuario?  @relation("Denunciante", fields: [denuncianteId], references: [id], onDelete: SetNull)
  usuario            Usuario?  @relation("UsuarioDenunciado", fields: [usuarioId], references: [id], onDelete: Cascade)
  post               Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  resolvidoPor       Usuario?  @relation("DenunciaModerador", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@index([status, criadoEm], map: "idx_denuncias_status_criado_em")
  @@index([usuarioId], map: "idx_denuncias_usuario_id")
  @@index([postId], map: "idx_denuncias_post_id")
  @@map("denuncias")
}

model MensagemPrivada {
  id             Int      @id @default(autoincrement())
  remetenteId    Int      @map("remetente_id")
  destinatarioId Int      @map("destinatario_id")
  mensagem       String
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  remetente      Usuario  @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario   Usuario  @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([destinatarioId], map: "idx_mensagens_privadas_destinatario_id")
  @@index([remetenteId, destinatarioId, criadoEm(sort: Desc)], map: "idx_mensagens_privadas_conversa")
  @@index([destinatarioId, lida], map: "idx_mensagens_privadas_nao_lidas")
  @@map("mensagens_privadas")
}

model Grupo {
  id            Int                @id @default(autoincrement())
  donoId        Int                @map("dono_id")
  nome          String             @db.VarChar(150)
  descricao     String
  categoria     String             @default("Geral") @db.VarChar(100)
  codigoConvite String             @unique @map("codigo_convite") @db.VarChar(20)
  tipo          String             @default("publico") @db.VarChar(30)
  testeExpiraEm DateTime?          @map("teste_expira_em") @db.Timestamp(6)
  acessoPago    Boolean            @default(false) @map("acesso_pago")
  criadoEm      DateTime           @default(now()) @map("criado_em") @db.Timestamp(6)
  dono          Usuario            @relation(fields: [donoId], references: [id], onDelete: Cascade)
  membros       GrupoMembro[]
  mensagens     GrupoMensagem[]
  solicitacoes  GrupoSolicitacao[]

  @@index([donoId], map: "idx_grupos_dono_id")
  @@index([tipo, criadoEm(sort: Desc)], map: "idx_grupos_tipo_criado_em")
  @@map("grupos")
}

model GrupoMembro {
  id        Int      @id @default(autoincrement())
  grupoId   Int      @map("grupo_id")
  usuarioId Int      @map("usuario_id")
  papel     String   @default("membro") @db.VarChar(50)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@index([usuarioId], map: "idx_grupo_membros_usuario_id")
  @@map("grupo_membros")
}

model GrupoMensagem {
  id        Int      @id @default(autoincrement())
  grupoId   Int      @map("grupo_id")
  usuarioId Int      @map("usuario_id")
  mensagem  String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([grupoId, criadoEm], map: "idx_grupo_mensagens_grupo_id")
  @@index([usuarioId], map: "idx_grupo_mensagens_usuario_id")
  @@map("grupo_mensagens")
}

model GrupoSolicitacao {
  id           Int      @id @default(autoincrement())
  grupoId      Int      @map("grupo_id")
  usuarioId    Int      @map("usuario_id")
  status       String   @default("pendente") @db.VarChar(30)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamp(6)
  grupo        Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@index([grupoId, status], map: "idx_grupo_solicitacoes_grupo_status")
  @@index([usuarioId], map: "idx_grupo_solicitacoes_usuario_id")
  @@map("grupo_solicitacoes")
}

model Bloqueio {
  id           Int      @id @default(autoincrement())
  bloqueadorId Int      @map("bloqueador_id")
  bloqueadoId  Int      @map("bloqueado_id")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  bloqueador   Usuario  @relation("Bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueado    Usuario  @relation("Bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@unique([bloqueadorId, bloqueadoId])
  @@index([bloqueadoId], map: "idx_bloqueios_bloqueado_id")
  @@map("bloqueios")
}

model DebatePosicao {
  id           Int      @id @default(autoincrement())
  postId       Int      @map("post_id")
  usuarioId    Int      @map("usuario_id")
  lado         String   @db.VarChar(1)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamp(6)
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([postId, usuarioId])
  @@index([postId, lado], map: "idx_debate_posicoes_post_lado")
  @@map("debate_posicoes")
}

model DebateArgumento {
  id        Int              @id @default(autoincrement())
  postId    Int              @map("post_id")
  usuarioId Int              @map("usuario_id")
  lado      String           @db.VarChar(1)
  texto     String           @db.VarChar(800)
  criadoEm  DateTime         @default(now()) @map("criado_em") @db.Timestamp(6)
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  votos     ArgumentoVoto[]
  mudancas  MudancaOpiniao[]

  @@index([postId, lado], map: "idx_debate_argumentos_post_lado")
  @@index([usuarioId], map: "idx_debate_argumentos_usuario_id")
  @@map("debate_argumentos")
}

model ArgumentoVoto {
  id          Int             @id @default(autoincrement())
  argumentoId Int             @map("argumento_id")
  usuarioId   Int             @map("usuario_id")
  criadoEm    DateTime        @default(now()) @map("criado_em") @db.Timestamp(6)
  argumento   DebateArgumento @relation(fields: [argumentoId], references: [id], onDelete: Cascade)
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([argumentoId, usuarioId])
  @@index([usuarioId], map: "idx_argumento_votos_usuario_id")
  @@map("argumento_votos")
}

// Registro de cada troca de lado — e, se a pessoa quiser, qual argumento a convenceu.
model MudancaOpiniao {
  id          Int              @id @default(autoincrement())
  postId      Int              @map("post_id")
  usuarioId   Int              @map("usuario_id")
  de          String           @db.VarChar(1)
  para        String           @db.VarChar(1)
  argumentoId Int?             @map("argumento_id")
  criadoEm    DateTime         @default(now()) @map("criado_em") @db.Timestamp(6)
  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario     Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  argumento   DebateArgumento? @relation(fields: [argumentoId], references: [id], onDelete: SetNull)

  @@index([usuarioId], map: "idx_mudancas_opiniao_usuario_id")
  @@index([argumentoId], map: "idx_mudancas_opiniao_argumento_id")
  @@index([postId], map: "idx_mudancas_opiniao_post_id")
  @@map("mudancas_opiniao")
}
