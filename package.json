{
  "name": "plataforma---postfan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "render-build": "npm ci --include=dev && npm run build && npm --prefix backend ci --include=dev && npm --prefix backend run prisma:generate && npm --prefix backend run prisma:migrate:deploy && npm --prefix backend prune --omit=dev",
    "start": "node backend/server.js",
    "lint": "eslint .",
    "test": "npm --prefix backend test",
    "preview": "vite preview",
    "mobile:build": "vite build --mode mobile",
    "android:sync": "npm run mobile:build && node scripts/run-capacitor.cjs sync android",
    "android:open": "node scripts/run-capacitor.cjs open android",
    "android:run": "npm run android:sync && node scripts/run-capacitor.cjs run android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
